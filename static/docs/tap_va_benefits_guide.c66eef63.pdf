         <pdf:Producer>Adobe PDF library 17.00</pdf:Producer>
         <Iptc4xmpCore:AltTextAccessibility>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">SGLI and VGLI key conversation time frames infographic. SGLI continues free for 120 days after being assigned to IRR. There is no insurance coverage from day 121 to the day SGLI is converted to VGLI.  SGLI can be converted to VGLI up to 485 days after the date assigned to IRR. SGLI can be converted to VGLI with no health requirements up to 240 days from the date assigned to IRR. SGLI can be converted to VGLI with health requirements between 241 and 485 days from the date assigned to IRR. After 485 days from the date assigned to IRR, SGLI can no longer be converted.</rdf:li>
            </rdf:Alt>
         </Iptc4xmpCore:AltTextAccessibility>
      </rdf:Description>
   </rdf:RDF>
