         <Iptc4xmpCore:AltTextAccessibility>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The VA Health Care Registration Outreach process. As you are preparing for registration, a registration representative will contact you to provide information about VA health care benefits and answer your questions. After separation, a representative will contact you by phone to answer your questions and, if you're interested, help you register for VA health care and make your first VA medical appointment.</rdf:li>
            </rdf:Alt>
         </Iptc4xmpCore:AltTextAccessibility>
      </rdf:Description>
   </rdf:RDF>
