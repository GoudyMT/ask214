         <pdf:Producer>Adobe PDF library 17.00</pdf:Producer>
         <Iptc4xmpCore:AltTextAccessibility>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Infograpghic of the VA disability claims process</rdf:li>
            </rdf:Alt>
         </Iptc4xmpCore:AltTextAccessibility>
         <Iptc4xmpCore:ExtDescrAccessibility>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Infograpghic of the VA disability claims process. There are five steps: VA receives the claim. VA examines your claim to determine if there is a need for additional evidence. VA gathers and reviews required evidence. VA prepares a rating decision. VA sends a notification letter with the rating decision.</rdf:li>
            </rdf:Alt>
         </Iptc4xmpCore:ExtDescrAccessibility>
      </rdf:Description>
   </rdf:RDF>
