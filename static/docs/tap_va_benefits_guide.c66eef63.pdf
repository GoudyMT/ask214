         <pdf:Producer>Adobe PDF library 17.00</pdf:Producer>
         <Iptc4xmpCore:AltTextAccessibility>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Infograpghic of the VA GI application process</rdf:li>
            </rdf:Alt>
         </Iptc4xmpCore:AltTextAccessibility>
         <Iptc4xmpCore:ExtDescrAccessibility>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Infograpghic of the VA GI application process. There are five steps: Submit your application. VA processes your claim (about 30 days.) Upon approval, you receive a Certificate of Eligibility (COE.) Share your COE letter with your VA School Certifying Official (SCO.) Use your education benefits.</rdf:li>
            </rdf:Alt>
         </Iptc4xmpCore:ExtDescrAccessibility>
      </rdf:Description>
   </rdf:RDF>
</x:xmpmeta>
