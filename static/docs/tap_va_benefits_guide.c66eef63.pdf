         <pdf:Producer>Adobe PDF library 17.00</pdf:Producer>
         <Iptc4xmpCore:AltTextAccessibility>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Infographic of the timeline showing what to use when for filing disability claims.</rdf:li>
            </rdf:Alt>
         </Iptc4xmpCore:AltTextAccessibility>
         <Iptc4xmpCore:ExtDescrAccessibility>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Disability claim time frames flowchart infographic. For pre-discharge claims, use the BDD program 90 to 180 days prior to discharge and the FDC program 0 to 90 days prior to discharge. Claims filed pre-separation or up to one year after separation are effective retroactive to the date of separation or retirement. For post-discharge claims, use the FDC program or file a traditional claim (there is no time limit). Claims filed more than one year after separation are not retroactive.</rdf:li>
            </rdf:Alt>
         </Iptc4xmpCore:ExtDescrAccessibility>
      </rdf:Description>
   </rdf:RDF>
</x:xmpmeta>
