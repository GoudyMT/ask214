         <pdf:Producer>Adobe PDF library 17.00</pdf:Producer>
         <Iptc4xmpCore:AltTextAccessibility>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Infographic of M2VA services</rdf:li>
            </rdf:Alt>
         </Iptc4xmpCore:AltTextAccessibility>
         <Iptc4xmpCore:ExtDescrAccessibility>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Infographic of M2VA services. These include facilitation of VA registration or enrollment and initial appointment scheduling, linkage with VA and community resources, help communicating with your care team, education related to VA care and benefits, coordination of care and services, and assistance with health care system navigation and advocacy.</rdf:li>
            </rdf:Alt>
         </Iptc4xmpCore:ExtDescrAccessibility>
      </rdf:Description>
   </rdf:RDF>
