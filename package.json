{
	"name": "ask214",
	"private": true,
	"version": "1.12.0",
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"packageManager": "pnpm@11.2.2",
	"engines": {
		"node": ">=22.22.1"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p src/service-worker",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:bundle": "size-limit",
		"check:embed-determinism": "tsx content-ops/check-embed-determinism.mjs",
		"check:content-ops": "tsc --noEmit -p tsconfig.content-ops.json",
		"check:worker": "wrangler types workers/retrieve/worker-configuration.d.ts --config workers/retrieve/wrangler.jsonc && tsc --noEmit -p tsconfig.worker.json",
		"validate:sources": "tsx content-ops/validate-sources.mjs",
		"build:sources-index": "tsx content-ops/build-sources-index.mjs",
		"check:sources-index": "tsx content-ops/check-sources-index.mjs",
		"check:pdf-worker": "tsx content-ops/check-pdf-worker.mjs",
		"check:backup-vendor": "tsx content-ops/check-backup-vendor.mjs",
		"curate:backup-words": "tsx content-ops/curate-backup-words.mjs",
		"build:backup-kdf": "tsx content-ops/build-backup-kdf.mjs",
		"check:served-history": "node content-ops/check-served-history.mjs",
		"check:live": "node content-ops/live-check.mjs",
		"check:chunks": "tsx content-ops/check-chunk-budget.mjs",
		"size:band": "tsx content-ops/apply-size-band.mjs",
		"check:commit-msg": "tsx content-ops/check-commit-message.mjs",
		"check:commits": "tsx content-ops/check-commit-message.mjs --range",
		"ingest": "tsx content-ops/capture-extract.mjs",
		"clean": "tsx content-ops/clean-sources.mjs",
		"chunk": "tsx content-ops/chunk-sources.mjs",
		"embed": "tsx content-ops/build-corpus.mjs",
		"eval": "tsx content-ops/run-eval.mjs",
		"answer-gate": "tsx content-ops/answer-gate.mjs",
		"answer-gate:bge": "tsx content-ops/answer-gate-bge.mjs",
		"embed:bge": "tsx content-ops/build-corpus-bge.mjs",
		"eval:bge": "tsx content-ops/eval-corpus-bge.mjs",
		"refresh": "tsx content-ops/refresh.mjs",
		"derive:pdfs": "python content-ops/derive_served_pdfs.py",
		"serve:pdfs": "tsx content-ops/serve-pdfs.mjs",
		"verify:pdfs": "tsx content-ops/verify-served-pdfs.mjs",
		"compare:pdfs": "python content-ops/compare_served_quality.py",
		"highlight-gate": "tsx content-ops/highlight-gate.mjs",
		"corpus": "tsx content-ops/corpus.mjs",
		"backfill:sources": "tsx content-ops/backfill-sources.mjs",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test --grep-invert @slow",
		"test:e2e:offline": "playwright test --grep @slow"
	},
	"lint-staged": {
		"*.{js,mjs,cjs,ts,svelte}": [
			"eslint --fix --fix-type problem,suggestion,layout",
			"prettier --write"
		],
		"*.{json,css,html,md,yml,yaml}": [
			"prettier --write"
		]
	},
	"size-limit": [
		{
			"name": "SvelteKit entry",
			"path": ".svelte-kit/output/client/_app/immutable/entry/*.js",
			"limit": "10 KB",
			"gzip": true
		},
		{
			"name": "Root layout node (loaded on every page)",
			"path": ".svelte-kit/output/client/_app/immutable/nodes/0.*.js",
			"limit": "9820 B",
			"gzip": true
		},
		{
			"name": "Lazy route nodes (sum; no single page loads all of them)",
			"path": ".svelte-kit/output/client/_app/immutable/nodes/[1-9]*.js",
			"limit": "60224 B",
			"gzip": true
		}
	],
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@lhci/cli": "^0.15.1",
		"@playwright/test": "1.64.1",
		"@size-limit/file": "^13.0.3",
		"@sveltejs/adapter-cloudflare": "^8.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/load-config": "^0.2.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26",
		"@vitejs/plugin-basic-ssl": "^2.3.0",
		"@vitest/browser-playwright": "5.0.5",
		"axe-core": "4.11.4",
		"esbuild": "0.28.2",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"linkedom": "^0.18.13",
		"lint-staged": "^17.6.0",
		"playwright": "1.64.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"size-limit": "^13.0.3",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tsx": "^4.23.15",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vitest": "5.0.5",
		"vitest-browser-svelte": "3.1.0",
		"wrangler": "^4.148.0",
		"yaml": "^2.9.0"
	},
	"dependencies": {
		"@huggingface/transformers": "^4.2.0",
		"@noble/hashes": "2.4.0",
		"pdfjs-dist": "^6.3.289"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
