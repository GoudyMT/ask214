{
	"name": "military-transition-app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.2.2",
	"engines": {
		"node": ">=22.13"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:bundle": "size-limit",
		"check:embed-determinism": "tsx content-ops/check-embed-determinism.mjs",
		"check:content-ops": "tsc --noEmit -p tsconfig.content-ops.json",
		"check:worker": "wrangler types workers/retrieve/worker-configuration.d.ts --config workers/retrieve/wrangler.jsonc && tsc --noEmit -p tsconfig.worker.json",
		"validate:sources": "tsx content-ops/validate-sources.mjs",
		"ingest": "tsx content-ops/capture-extract.mjs",
		"clean": "tsx content-ops/clean-sources.mjs",
		"chunk": "tsx content-ops/chunk-sources.mjs",
		"embed": "tsx content-ops/build-corpus.mjs",
		"eval": "tsx content-ops/run-eval.mjs",
		"embed:bge": "tsx content-ops/build-corpus-bge.mjs",
		"eval:bge": "tsx content-ops/eval-corpus-bge.mjs",
		"refresh": "tsx content-ops/refresh.mjs",
		"corpus": "tsx content-ops/corpus.mjs",
		"backfill:sources": "tsx content-ops/backfill-sources.mjs",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test --grep-invert @slow",
		"test:e2e:offline": "playwright test --grep @slow"
	},
	"lint-staged": {
		"*.{js,mjs,cjs,ts,svelte}": [
			"eslint --fix --fix-type problem,suggestion,layout",
			"prettier --write"
		],
		"*.{json,css,html,md,yml,yaml}": [
			"prettier --write"
		]
	},
	"size-limit": [
		{
			"name": "SvelteKit entry",
			"path": ".svelte-kit/output/client/_app/immutable/entry/*.js",
			"limit": "10 KB",
			"gzip": true
		},
		{
			"name": "SvelteKit chunks",
			"path": ".svelte-kit/output/client/_app/immutable/chunks/*.js",
			"limit": "50 KB",
			"gzip": true
		},
		{
			"name": "SvelteKit nodes",
			"path": ".svelte-kit/output/client/_app/immutable/nodes/*.js",
			"limit": "34 KB",
			"gzip": true
		}
	],
	"devDependencies": {
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@lhci/cli": "^0.15.1",
		"@playwright/test": "^1.61.1",
		"@size-limit/file": "^12.1.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26",
		"@vitejs/plugin-basic-ssl": "^2.3.0",
		"@vitest/browser-playwright": "^4.1.10",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.7.0",
		"husky": "^9.1.7",
		"linkedom": "^0.18.12",
		"lint-staged": "^17.3.0",
		"pdfjs-dist": "^6.2.108",
		"playwright": "^1.61.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"size-limit": "^12.1.0",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"tsx": "^4.23.5",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.1.4",
		"vitest": "^4.1.10",
		"vitest-browser-svelte": "^2.1.0",
		"wrangler": "^4.118.0",
		"yaml": "^2.9.0"
	},
	"dependencies": {
		"@huggingface/transformers": "^4.2.0"
	}
}
