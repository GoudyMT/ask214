{
	"name": "military-transition-app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.2.2",
	"engines": {
		"node": ">=22.13"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:bundle": "size-limit",
		"validate:sources": "tsx content-ops/validate-sources.mjs",
		"ingest": "tsx content-ops/capture-extract.mjs",
		"chunk": "tsx content-ops/chunk-sources.mjs",
		"embed": "tsx content-ops/build-corpus.mjs",
		"eval": "tsx content-ops/run-eval.mjs",
		"backfill:sources": "tsx content-ops/backfill-sources.mjs",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test --grep-invert @slow",
		"test:e2e:offline": "playwright test --grep @slow"
	},
	"lint-staged": {
		"*.{js,mjs,cjs,ts,svelte}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,css,html,md,yml,yaml}": [
			"prettier --write"
		]
	},
	"size-limit": [
		{
			"name": "SvelteKit entry",
			"path": ".svelte-kit/output/client/_app/immutable/entry/*.js",
			"limit": "10 KB",
			"gzip": true
		},
		{
			"name": "SvelteKit chunks",
			"path": ".svelte-kit/output/client/_app/immutable/chunks/*.js",
			"limit": "50 KB",
			"gzip": true
		},
		{
			"name": "SvelteKit nodes",
			"path": ".svelte-kit/output/client/_app/immutable/nodes/*.js",
			"limit": "20 KB",
			"gzip": true
		}
	],
	"devDependencies": {
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@lhci/cli": "^0.15.1",
		"@playwright/test": "^1.59.1",
		"@size-limit/file": "^12.1.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.65.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^25",
		"@vitest/browser-playwright": "^4.1.8",
		"eslint": "^10.5.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.4.0",
		"husky": "^9.1.7",
		"linkedom": "^0.18.12",
		"lint-staged": "^17.0.7",
		"pdfjs-dist": "^6.0.227",
		"playwright": "^1.59.1",
		"prettier": "^3.8.4",
		"prettier-plugin-svelte": "^4.1.0",
		"size-limit": "^12.1.0",
		"svelte": "^5.56.3",
		"svelte-check": "^4.6.0",
		"tsx": "^4.22.4",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.61.0",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.0",
		"wrangler": "^4.100.0",
		"yaml": "^2.9.0"
	},
	"dependencies": {
		"@huggingface/transformers": "^4.2.0"
	}
}
